#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CLI de utilidades del proyecto. Uso:
 *   php bin/console migrate            Ejecuta las migraciones pendientes.
 *   php bin/console migrate:rollback   Revierte el último batch de migraciones.
 *   php bin/console db:seed            Ejecuta los seeders (datos iniciales).
 *   php bin/console demo:seed          Carga productos/servicios de MUESTRA para visualizar el frontend.
 *   php bin/console images:fix-placeholders  Corrige el fondo oscuro de las imágenes
 *                                             de marcador de posición YA generadas (ver DemoDataSeeder.php).
 */

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Database\DemoDataSeeder;
use App\Infrastructure\Config\Config;
use App\Infrastructure\Database\Connection;
use App\Infrastructure\Database\Migrator;
use App\Infrastructure\Logging\Logger;

$basePath = dirname(__DIR__);

Config::boot($basePath);
Logger::boot($basePath);

$command = $argv[1] ?? null;

function console_line(string $text): void
{
    fwrite(STDOUT, $text . PHP_EOL);
}

function console_error(string $text): void
{
    fwrite(STDERR, $text . PHP_EOL);
}

try {
    switch ($command) {
        case 'migrate':
            $migrator = new Migrator(Connection::get(), $basePath . '/database/migrations');
            $ran = $migrator->migrate();

            if (empty($ran)) {
                console_line('No hay migraciones pendientes.');
                break;
            }

            console_line('Migraciones aplicadas:');
            foreach ($ran as $file) {
                console_line('  ✔ ' . $file);
            }
            break;

        case 'migrate:rollback':
            $migrator = new Migrator(Connection::get(), $basePath . '/database/migrations');
            $rolledBack = $migrator->rollback();

            if (empty($rolledBack)) {
                console_line('No hay migraciones para revertir.');
                break;
            }

            console_line('Migraciones revertidas:');
            foreach ($rolledBack as $file) {
                console_line('  ↩ ' . $file);
            }
            break;

        case 'db:seed':
            $connection = Connection::get();
            $seedersPath = $basePath . '/database/seeders';
            $files = glob($seedersPath . '/*.php') ?: [];
            sort($files);

            foreach ($files as $file) {
                /** @var \App\Infrastructure\Database\Seeder $seeder */
                $seeder = require $file;
                $seeder->run($connection);
                console_line('  ✔ ' . basename($file));
            }

            console_line('Seeders ejecutados correctamente.');
            break;

        case 'demo:seed':
            (new DemoDataSeeder(Connection::get(), $basePath))->run();
            console_line('Datos de muestra cargados (productos y servicios con imágenes de marcador de posición).');
            break;

        case 'images:fix-placeholders':
            // Corrección puntual (2026-08): DemoDataSeeder generaba estas SVG con
            // fondo #1e1e1e (oscuro), quemado en el archivo — se veía mal en modo
            // claro (.card ya es blanca ahí, ver main.css). El seeder ya se
            // corrigió para lo nuevo; esto arregla lo YA generado, en el sitio real
            // (sin Terminal/SSH: se corre una vez vía Cron Job, ver docs de deploy).
            $fixed = 0;
            foreach (['products', 'services'] as $subdirectory) {
                $directory = $basePath . '/storage/uploads/' . $subdirectory;
                foreach (glob($directory . '/*.svg') ?: [] as $file) {
                    $content = file_get_contents($file);
                    if ($content === false || !str_contains($content, 'fill="#1e1e1e"')) {
                        continue;
                    }

                    $content = str_replace('fill="#1e1e1e"', 'fill="#ffffff"', $content);
                    $content = str_replace('fill="#f4c430" font-family=', 'fill="#0d0d0d" font-family=', $content);
                    file_put_contents($file, $content);
                    $fixed++;
                }
            }

            console_line("Imágenes de marcador de posición corregidas: {$fixed}.");
            break;

        default:
            console_error('Comando no reconocido: ' . ($command ?? '(ninguno)'));
            console_line('');
            console_line('Comandos disponibles:');
            console_line('  migrate             Ejecuta las migraciones pendientes.');
            console_line('  migrate:rollback    Revierte el último batch de migraciones.');
            console_line('  db:seed             Ejecuta los seeders (datos iniciales).');
            console_line('  demo:seed           Carga productos/servicios de muestra para visualizar el frontend.');
            console_line('  images:fix-placeholders  Corrige el fondo oscuro de imágenes de marcador ya generadas.');
            exit(1);
    }
} catch (Throwable $e) {
    console_error('Error: ' . $e->getMessage());
    Logger::error('Fallo en comando CLI: ' . $command, ['message' => $e->getMessage()]);
    exit(1);
}

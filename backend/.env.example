# =============================================================
# CASTAMOTO — Variables de entorno (ejemplo)
# Copiar este archivo como ".env" y ajustar los valores reales.
# NUNCA subir el archivo ".env" real al repositorio.
# =============================================================

# --- Aplicación ---
APP_NAME=CASTAMOTO
APP_ENV=local
# local | production  -> en production se ocultan detalles internos de errores
APP_URL=http://localhost/proyectos/castamotos
APP_TIMEZONE=America/Bogota

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=castamoto
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Autenticación / JWT (se usa a partir de la Fase 2) ---
JWT_SECRET=
JWT_TTL=3600

# --- Correo ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@castamoto.local
MAIL_FROM_NAME=CASTAMOTO

# --- Pagos (se usa a partir de la Fase 7) ---
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# --- Inteligencia artificial (se usa a partir de la Fase 11) ---
AI_PROVIDER=
AI_API_KEY=

# --- Notificaciones push ---
PUSH_PROVIDER=

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- Usuario administrador inicial (solo para el seeder, entorno local) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@castamoto.local
ADMIN_PASSWORD=CambiarEsteClave123!
